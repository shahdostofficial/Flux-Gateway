{
  "name": "flux-gateway",
  "version": "1.1.1",
  "description": "An open-source AI request switcher and universal gateway for continuous AI access.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "flux-gateway": "./dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "rebuild": "npm run clean && npm run build",
    "prepublishOnly": "npm run rebuild && npm test",
    "example": "node --loader ts-node/esm examples/simple-usage.ts",
    "chat": "node --loader ts-node/esm examples/chat.ts",
    "ask": "node --loader ts-node/esm src/cli.ts ask",
    "test": "node --loader ts-node/esm tests/mock-test.ts"
  },
  "keywords": [
    "ai",
    "gateway",
    "router",
    "switcher",
    "free-ai",
    "openrouter",
    "groq",
    "llm",
    "failover"
  ],
  "author": {
    "name": "Shah Dost",
    "email": "shahdost.block@gmail.com",
    "url": "https://github.com/shahdostofficial"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "axios": "^1.15.1",
    "chalk": "^4.1.2",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2"
  }
}
