# API Keys for FluxGateway Rotation
# Copy this file to `.env` and fill in any keys you have.
# Any provider whose key is missing will simply be skipped by the CLI.

OPENROUTER_API_KEY=your_openrouter_key_here
GROQ_API_KEY=your_groq_key_here
TOGETHER_API_KEY=your_together_key_here

# MeridianBlue — AI Gateway that proxies many upstream providers under one key.
# Default base URL is the staging server; override with MERIDIAN_BLUE_BASE_URL
# if you're on production or self-hosted.
MERIDIAN_BLUE_API_KEY=your_meridian_blue_key_here
# MERIDIAN_BLUE_BASE_URL=http://178.63.197.107:3000

DEEPSEEK_API_KEY=your_deepseek_key_here
HUGGINGFACE_API_KEY=your_huggingface_key_here
SHUTTLEAI_API_KEY=your_shuttleai_key_here
DEEPINFRA_API_KEY=your_deepinfra_key_here

# Gateway aggregators with free tiers
CEREBRAS_API_KEY=your_cerebras_key_here
SAMBANOVA_API_KEY=your_sambanova_key_here

# Cloudflare Workers AI — free daily neurons, edge-hosted open models.
# Needs BOTH your account ID and an API token with "Workers AI: Read" permission.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_KEY=your_cloudflare_api_token_here

# Pollinations.ai requires no API key but is community-run (no SLA).
# By default the CLI only uses it when NO other provider is configured.
# Set to 1 to explicitly include it in the rotation alongside your real providers.
# FLUX_ENABLE_POLLINATIONS=1
